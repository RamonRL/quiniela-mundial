# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Drizzle / direct Postgres connection (use the connection string from Supabase Settings → Database)
# Use the "Session" pooler URL for migrations and the "Transaction" pooler for the app runtime.
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Admin allowlist — comma-separated emails that get admin role on first login
ADMIN_EMAILS=ramon.romero@unnax.com

# App branding
NEXT_PUBLIC_APP_NAME="World Cup Championship"

# Tournament timing — used to gate visibility of pre-tournament predictions
NEXT_PUBLIC_TOURNAMENT_KICKOFF_AT=2026-06-11T20:00:00Z

# Lemon Squeezy (Merchant of Record para los Pases Mundial 2026)
# URLs de hosted checkout — una por tier. Las saca el dueño desde el
# dashboard de LS al crear cada producto/variante. Si faltan, los
# botones de "Comprar" en /precios caen al formulario de contacto.
LEMONSQUEEZY_CHECKOUT_TEAM_50=
LEMONSQUEEZY_CHECKOUT_TEAM_100=
LEMONSQUEEZY_CHECKOUT_TEAM_250=
# Signing secret del webhook (Settings → Webhooks → tu webhook).
# Sin esto el endpoint /api/lemon-squeezy/webhook rechaza todas las
# peticiones con 401.
LEMONSQUEEZY_WEBHOOK_SECRET=
